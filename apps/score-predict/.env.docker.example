# `pnpm local:up` creates `.env.docker.local` from the running local Supabase stack.
# This example intentionally contains no real key or password.
DATABASE_URL="postgresql://postgres:<local-password>@host.docker.internal:54332/postgres?schema=score_predict_fire"
DIRECT_URL="postgresql://postgres:<local-password>@host.docker.internal:54332/postgres?schema=score_predict_fire"
NEXTAUTH_SECRET="<local-only-random-secret>"
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54331"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<local-anon-key>"
SUPABASE_URL="http://host.docker.internal:54331"
SUPABASE_SERVICE_ROLE_KEY="<local-service-role-key>"
SUPABASE_STORAGE_BUCKET="uploads"
PASSWORD_RESET_DEBUG_LINK="true"
ADMIN_PHONE="010-0000-0000"
ADMIN_PASSWORD="<local-admin-password>"
