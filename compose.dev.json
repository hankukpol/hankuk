{
  "name": "hankuk-dev",
  "services": {
    "academy-ops": {
      "image": "hankuk-academy-ops-dev:local",
      "build": {
        "context": ".",
        "dockerfile": "docker/Dockerfile.dev",
        "args": {
          "APP": "academy-ops"
        }
      },
      "init": true,
      "profiles": [
        "academy-ops"
      ],
      "ports": [
        "127.0.0.1:3100:3100"
      ],
      "env_file": [
        "docker/environments/academy-ops.env.local"
      ],
      "environment": {
        "NODE_ENV": "development",
        "PORT": "3100",
        "WATCHPACK_POLLING": "true",
        "NEXT_TELEMETRY_DISABLED": "1"
      },
      "extra_hosts": [
        "host.docker.internal:host-gateway"
      ],
      "develop": {
        "watch": [
          {
            "action": "sync",
            "path": "apps/academy-ops/src",
            "target": "/workspace/apps/academy-ops/src",
            "initial_sync": true,
            "ignore": [
              "node_modules/",
              ".env*",
              ".local/",
              ".mock-db/",
              "*.log",
              "*.tsbuildinfo",
              "__*"
            ]
          },
          {
            "action": "sync",
            "path": "apps/academy-ops/public",
            "target": "/workspace/apps/academy-ops/public",
            "initial_sync": true,
            "ignore": [
              "node_modules/",
              ".env*",
              ".local/",
              ".mock-db/",
              "*.log",
              "*.tsbuildinfo",
              "__*"
            ]
          },
          {
            "action": "sync",
            "path": "apps/academy-ops/prisma",
            "target": "/workspace/apps/academy-ops/prisma",
            "initial_sync": true,
            "ignore": [
              "node_modules/",
              ".env*",
              ".local/",
              ".mock-db/",
              "*.log",
              "*.tsbuildinfo",
              "__*"
            ]
          },
          {
            "action": "sync",
            "path": "apps/academy-ops/scripts",
            "target": "/workspace/apps/academy-ops/scripts",
            "initial_sync": true,
            "ignore": [
              "node_modules/",
              ".env*",
              ".local/",
              ".mock-db/",
              "*.log",
              "*.tsbuildinfo",
              "__*"
            ]
          },
          {
            "action": "sync+restart",
            "path": "apps/academy-ops/.eslintrc.json",
            "target": "/workspace/apps/academy-ops/.eslintrc.json"
          },
          {
            "action": "sync+restart",
            "path": "apps/academy-ops/next.config.mjs",
            "target": "/workspace/apps/academy-ops/next.config.mjs"
          },
          {
            "action": "sync+restart",
            "path": "apps/academy-ops/postcss.config.mjs",
            "target": "/workspace/apps/academy-ops/postcss.config.mjs"
          },
          {
            "action": "sync+restart",
            "path": "apps/academy-ops/tailwind.config.ts",
            "target": "/workspace/apps/academy-ops/tailwind.config.ts"
          },
          {
            "action": "sync+restart",
            "path": "apps/academy-ops/tsconfig.json",
            "target": "/workspace/apps/academy-ops/tsconfig.json"
          },
          {
            "action": "rebuild",
            "path": "apps/academy-ops/package.json"
          },
          {
            "action": "rebuild",
            "path": "pnpm-lock.yaml"
          },
          {
            "action": "sync+restart",
            "path": "packages/config",
            "target": "/workspace/packages/config",
            "ignore": [
              "node_modules/"
            ]
          }
        ]
      },
      "healthcheck": {
        "test": [
          "CMD",
          "node",
          "-e",
          "fetch('http://127.0.0.1:3100/login').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
        ],
        "interval": "30s",
        "timeout": "25s",
        "start_period": "120s",
        "retries": 5
      }
    },
