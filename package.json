{
  "name": "hankuk",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "prepare:pnpm": "corepack prepare pnpm@10.0.0 --activate",
    "local:dev:score-predict": "pnpm --dir ./apps/score-predict local:dev",
    "dev:score-predict": "pnpm --dir ./apps/score-predict dev",
    "dev:study-hall": "pnpm --dir ./apps/study-hall dev",
    "dev:interview-pass": "pnpm --dir ./apps/interview-pass dev",
    "dev:class-pass": "pnpm --dir ./apps/class-pass dev",
    "dev:portal": "pnpm --dir ./apps/portal dev",
    "dev:academy-ops": "pnpm --dir ./apps/academy-ops dev",
    "dev:interview-mate": "pnpm --dir ./apps/interview-mate dev",
    "dev:police-exam-bank": "node scripts/docker-dev.mjs dev police-exam-bank",
    "build:score-predict": "pnpm --dir ./apps/score-predict build",
    "build:study-hall": "pnpm --dir ./apps/study-hall build",
    "build:interview-pass": "pnpm --dir ./apps/interview-pass build",
    "build:class-pass": "pnpm --dir ./apps/class-pass build",
    "build:portal": "pnpm --dir ./apps/portal build",
    "build:academy-ops": "pnpm --dir ./apps/academy-ops build",
    "build:interview-mate": "pnpm --dir ./apps/interview-mate build",
    "build:police-exam-bank": "pnpm --dir ./apps/police-exam-bank build",
    "turbo:build": "pnpm exec turbo run build",
    "turbo:lint": "pnpm exec turbo run lint",
    "turbo:typecheck": "pnpm exec turbo run typecheck",
    "turbo:dev": "node scripts/docker-dev.mjs dev all",
    "docker:setup": "node scripts/docker-config.mjs && node scripts/docker-env.mjs",
    "docker:dev": "node scripts/docker-dev.mjs dev",
    "docker:start": "node scripts/docker-dev.mjs start",
    "docker:stop": "node scripts/docker-dev.mjs stop",
    "docker:status": "node scripts/docker-dev.mjs status",
    "docker:check": "node scripts/docker-dev.mjs check",
    "docker:exec": "node scripts/docker-dev.mjs exec"
  },
  "devDependencies": {
    "pnpm": "10.0.0",
    "turbo": "^2.5.8"
  }
}
