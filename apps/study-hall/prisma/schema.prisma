generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum StudentStatus {
  ACTIVE
  ON_LEAVE
  WITHDRAWN
  GRADUATED
}

enum AttendanceStatus {
  PRESENT
  TARDY
  ABSENT
  EXCUSED
  HOLIDAY
  HALF_HOLIDAY
  NOT_APPLICABLE
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  ASSISTANT
}

enum LeaveType {
  HOLIDAY
  HALF_DAY
  HEALTH
  OUTING
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  USED
}

enum ResultType {
  WARNING_1
  WARNING_2
  INTERVIEW
  WITHDRAWAL
}

enum InterviewStatus {
  OPEN
  CLOSED
}

enum WarningNoticeChannel {
  SMS
  PHONE
  IN_PERSON
  OTHER
}

enum ExamScheduleType {
  WRITTEN
  PHYSICAL
  INTERVIEW
  RESULT
  OTHER
}

enum ExamCategory {
  MORNING
  REGULAR
}

enum PhoneSubmissionStatus {
  SUBMITTED
  NOT_SUBMITTED
  RENTED
}

model Division {
  id                String             @id @default(cuid())
  name              String
  slug              String             @unique
  fullName          String             @map("full_name")
  color             String
  isActive          Boolean            @default(true) @map("is_active")
  displayOrder      Int                @default(0) @map("display_order")
  createdAt         DateTime           @default(now()) @map("created_at")
  students          Student[]
  periods           Period[]
  pointRules        PointRule[]
  paymentCategories PaymentCategory[]
  tuitionPlans      TuitionPlan[]
  examTypes         ExamType[]
  studyRooms        StudyRoom[]
  seats             Seat[]
  settings          DivisionSettings?
  admins            Admin[]
  announcements     Announcement[]
  examSchedules     ExamSchedule[]
  phoneSubmissions  PhoneSubmission[]
  paymentOperations PaymentOperation[]
  chatMessages      ChatMessage[]
  chatReadStates    ChatReadState[]
  warningNotices    WarningNotice[]
  settingsHistory   DivisionSettingsHistory[]

  @@map("divisions")
}

model Student {
  id                  String             @id @default(cuid())
  divisionId          String             @map("division_id")
  name                String
  studentNumber       String             @map("student_number")
  studyTrack          String?            @map("study_track")
  phone               String?
  seatId              String?            @unique @map("seat_id")
  courseStartDate     DateTime?          @map("course_start_date") @db.Date
  courseEndDate       DateTime?          @map("course_end_date") @db.Date
  tuitionPlanId       String?            @map("tuition_plan_id")
  tuitionAmount       Int?               @map("tuition_amount")
  tuitionExempt       Boolean            @default(false) @map("tuition_exempt")
  tuitionExemptReason String?            @map("tuition_exempt_reason")
  status              StudentStatus      @default(ACTIVE)
  enrolledAt          DateTime           @default(now()) @map("enrolled_at")
  withdrawnAt         DateTime?          @map("withdrawn_at")
  withdrawnNote       String?            @map("withdrawn_note")
  memo                String?
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  division            Division           @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  seat                Seat?              @relation(fields: [seatId], references: [id], onDelete: SetNull)
  tuitionPlan         TuitionPlan?       @relation(fields: [tuitionPlanId], references: [id], onDelete: SetNull)
  attendanceRecords   Attendance[]
  pointRecords        PointRecord[]
  leavePermissions    LeavePermission[]
  interviews          Interview[]
  payments            Payment[]
  examScores          ExamScore[]
  morningExamScores   MorningExamScore[]
  scoreTargets        ScoreTarget[]
  phoneSubmissions    PhoneSubmission[]
  paymentOperations   PaymentOperation[]
  warningNotices      WarningNotice[]

  @@unique([divisionId, studentNumber])
  @@index([divisionId])
  @@index([divisionId, status])
  @@index([tuitionPlanId])
  @@map("students")
}

model Period {
  id                String            @id @default(cuid())
  divisionId        String            @map("division_id")
  name              String
  label             String?
  displayOrder      Int               @map("display_order")
  startTime         String            @map("start_time")
  endTime           String            @map("end_time")
  isMandatory       Boolean           @default(true) @map("is_mandatory")
  isActive          Boolean           @default(true) @map("is_active")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  division          Division          @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  attendanceRecords Attendance[]
  phoneSubmissions  PhoneSubmission[]

  @@unique([divisionId, displayOrder])
  @@index([divisionId])
  @@map("periods")
}

model Attendance {
  id           String           @id @default(cuid())
  studentId    String           @map("student_id")
  periodId     String           @map("period_id")
  date         DateTime         @db.Date
  status       AttendanceStatus
  reason       String?
  checkInTime  DateTime?        @map("check_in_time")
  recordedById String?          @map("recorded_by_id")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  student      Student          @relation(fields: [studentId], references: [id], onDelete: Restrict)
  period       Period           @relation(fields: [periodId], references: [id], onDelete: Cascade)
  recordedBy   Admin?           @relation("AttendanceRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([studentId, periodId, date])
  @@index([studentId, date])
  @@index([periodId, date])
  @@map("attendance")
}

model PointRule {
  id           String        @id @default(cuid())
  divisionId   String        @map("division_id")
  category     String
  name         String
  points       Int
  description  String?
  isActive     Boolean       @default(true) @map("is_active")
  displayOrder Int           @default(0) @map("display_order")
  createdAt    DateTime      @default(now()) @map("created_at")
  division     Division      @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  pointRecords PointRecord[]

  @@index([divisionId])
  @@map("point_rules")
}

model PointRecord {
  id           String     @id @default(cuid())
  studentId    String     @map("student_id")
  ruleId       String?    @map("rule_id")
  points       Int
  date         DateTime   @default(now())
  notes        String?
  recordedById String     @map("recorded_by_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Restrict)
  rule         PointRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  recordedBy   Admin      @relation("PointRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([studentId, date])
  @@index([ruleId])
  @@index([recordedById])
  @@map("point_records")
}

model LeavePermission {
  id           String      @id @default(cuid())
  studentId    String      @map("student_id")
  type         LeaveType
  date         DateTime    @db.Date
  reason       String?
  approvedById String      @map("approved_by_id")
  status       LeaveStatus
  createdAt    DateTime    @default(now()) @map("created_at")
  student      Student     @relation(fields: [studentId], references: [id], onDelete: Restrict)
  approvedBy   Admin       @relation("LeaveApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)

  @@index([studentId, date])
  @@index([approvedById])
  @@map("leave_permissions")
}

model Interview {
  id                String          @id @default(cuid())
  studentId         String          @map("student_id")
  date              DateTime
  trigger           String?
  reason            String
  content           String?
  result            String?
  resultType        ResultType      @map("result_type")
  // 후속 확인 예정일. 지나도 status 가 OPEN 이면 대시보드 "오늘 처리할 일"에 뜬다.
  followUpDate      DateTime?       @map("follow_up_date") @db.Date
  status            InterviewStatus @default(OPEN)
  guardianContacted Boolean         @default(false) @map("guardian_contacted")
  closedAt          DateTime?       @map("closed_at")
  closedById        String?         @map("closed_by_id")
  createdById       String          @map("created_by_id")
  createdAt         DateTime        @default(now()) @map("created_at")
  student           Student         @relation(fields: [studentId], references: [id], onDelete: Restrict)
  createdBy         Admin           @relation("InterviewCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  // 종결한 직원 계정이 삭제돼도 면담 기록 자체는 남아야 한다.
  closedBy          Admin?          @relation("InterviewClosedBy", fields: [closedById], references: [id], onDelete: SetNull)

  @@index([studentId, date])
  @@index([createdById])
  // 후속 확인 대기 목록 조회 전용.
  @@index([status, followUpDate])
  @@map("interviews")
}

// 경고 안내를 "실제로 했다"는 사실의 기록.
// 기준(division_settings)이 나중에 바뀌어도 당시 판단 근거가 남도록
// 점수·임계값·집계 방식을 안내 시점 스냅샷으로 함께 고정한다.
model WarningNotice {
  id                String               @id @default(cuid())
  divisionId        String               @map("division_id")
  studentId         String               @map("student_id")
  stage             ResultType
  demeritPoints     Int                  @map("demerit_points")
  // { warnLevel1, warnLevel2, warnInterview, warnWithdraw } 안내 시점 값.
  thresholdSnapshot Json                 @map("threshold_snapshot")
  // "MONTHLY" | "COURSE" — 당시 벌점 집계 방식.
  aggregationMode   String               @map("aggregation_mode")
  channel           WarningNoticeChannel
  noticeBody        String?              @map("notice_body")
  memo              String?
  noticedAt         DateTime             @default(now()) @map("noticed_at")
  noticedById       String?              @map("noticed_by_id")
  noticedByName     String               @map("noticed_by_name")
  createdAt         DateTime             @default(now()) @map("created_at")
  division          Division             @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  student           Student              @relation(fields: [studentId], references: [id], onDelete: Restrict)
  noticedBy         Admin?               @relation("WarningNoticeNoticedBy", fields: [noticedById], references: [id], onDelete: SetNull)

  // 같은 단계를 여러 번 안내할 수 있으므로 유니크 제약은 두지 않는다.
  @@index([studentId, stage, noticedAt])
  @@index([divisionId, noticedAt])
  @@map("warning_notices")
}

// 운영 규칙 변경 이력. changes 는 [{ field, label, before, after }] 배열.
model DivisionSettingsHistory {
  id            String   @id @default(cuid())
  divisionId    String   @map("division_id")
  section       String   @default("RULES")
  changes       Json
  changedById   String?  @map("changed_by_id")
  changedByName String   @map("changed_by_name")
  changedAt     DateTime @default(now()) @map("changed_at")
  division      Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  changedBy     Admin?   @relation("DivisionSettingsChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([divisionId, changedAt])
  @@map("division_settings_history")
}

model Payment {
  id                String          @id @default(cuid())
  studentId         String          @map("student_id")
  paymentTypeId     String          @map("payment_type_id")
  amount            Int
  paymentDate       DateTime        @map("payment_date") @db.Date
  method            String?
  paymentGroupId    String?         @map("payment_group_id")
  originalPaymentId String?         @map("original_payment_id")
  notes             String?
  recordedById      String          @map("recorded_by_id")
  createdAt         DateTime        @default(now()) @map("created_at")
  student           Student         @relation(fields: [studentId], references: [id], onDelete: Restrict)
  paymentType       PaymentCategory @relation(fields: [paymentTypeId], references: [id], onDelete: Restrict)
  recordedBy        Admin           @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([studentId, paymentDate])
  @@index([paymentTypeId])
  @@index([paymentGroupId])
  @@index([originalPaymentId])
  @@index([recordedById])
  @@map("payments")
}

model PaymentCategory {
  id           String    @id @default(cuid())
  divisionId   String    @map("division_id")
  name         String
  isActive     Boolean   @default(true) @map("is_active")
  displayOrder Int       @default(0) @map("display_order")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  division     Division  @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  payments     Payment[]

  @@unique([divisionId, name])
  @@index([divisionId])
  @@map("payment_categories")
}

model PaymentOperation {
  id             String   @id @default(cuid())
  divisionId     String   @map("division_id")
  studentId      String   @map("student_id")
  operationType  String   @map("operation_type")
  idempotencyKey String   @map("idempotency_key")
  result         Json?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  division       Division @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([divisionId, studentId, operationType, idempotencyKey], map: "payment_operations_division_student_operation_key_uidx")
  @@index([studentId, createdAt], map: "payment_operations_student_id_created_at_idx")
  @@map("payment_operations")
}

model TuitionPlan {
  id           String    @id @default(cuid())
  divisionId   String    @map("division_id")
  name         String
  durationDays Int?      @map("duration_days")
  amount       Int
  description  String?
  isActive     Boolean   @default(true) @map("is_active")
  displayOrder Int       @default(0) @map("display_order")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  division     Division  @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  students     Student[]

  @@unique([divisionId, name])
  @@index([divisionId])
  @@map("tuition_plans")
}

model ExamType {
  id            String             @id @default(cuid())
  divisionId    String             @map("division_id")
  name          String
  category      ExamCategory       @default(REGULAR)
  studyTrack    String?            @map("study_track")
  isActive      Boolean            @default(true) @map("is_active")
  displayOrder  Int                @default(0) @map("display_order")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  division      Division           @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  subjects      ExamSubject[]
  scores        ExamScore[]
  morningScores MorningExamScore[]
  scoreTargets  ScoreTarget[]

  @@index([divisionId])
  @@index([divisionId, category])
  @@map("exam_types")
}

model ExamSubject {
  id            String             @id @default(cuid())
  examTypeId    String             @map("exam_type_id")
  name          String
  totalItems    Int?               @map("total_items")
  pointsPerItem Float?             @map("points_per_item")
  displayOrder  Int                @default(0) @map("display_order")
  isActive      Boolean            @default(true) @map("is_active")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  examType      ExamType           @relation(fields: [examTypeId], references: [id], onDelete: Cascade)
  morningScores MorningExamScore[]

  @@index([examTypeId])
  @@map("exam_subjects")
}

model ExamScore {
  id           String    @id @default(cuid())
  studentId    String    @map("student_id")
  examTypeId   String    @map("exam_type_id")
  examRound    Int       @map("exam_round")
  examDate     DateTime? @map("exam_date") @db.Date
  scores       Json
  totalScore   Float?    @map("total_score")
  rankInClass  Int?      @map("rank_in_class")
  notes        String?
  recordedById String    @map("recorded_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  student      Student   @relation(fields: [studentId], references: [id], onDelete: Restrict)
  examType     ExamType  @relation(fields: [examTypeId], references: [id], onDelete: Cascade)
  recordedBy   Admin     @relation("ExamRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)

  @@unique([studentId, examTypeId, examRound])
  @@index([studentId])
  @@index([examTypeId, examRound])
  @@index([recordedById])
  @@map("exam_scores")
}

model MorningExamScore {
  id           String      @id @default(cuid())
  studentId    String      @map("student_id")
  examTypeId   String      @map("exam_type_id")
  subjectId    String      @map("subject_id")
  examDate     DateTime    @map("exam_date") @db.Date
  score        Int?
  weekNumber   Int         @map("week_number")
  weekYear     Int         @map("week_year")
  notes        String?
  recordedById String      @map("recorded_by_id")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  student      Student     @relation(fields: [studentId], references: [id], onDelete: Restrict)
  examType     ExamType    @relation(fields: [examTypeId], references: [id], onDelete: Cascade)
  subject      ExamSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  recordedBy   Admin       @relation("MorningExamRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)

  @@unique([studentId, examTypeId, subjectId, examDate])
  @@index([examTypeId, examDate])
  @@index([examTypeId, weekYear, weekNumber])
  @@index([studentId, weekYear, weekNumber])
  @@index([recordedById])
  @@map("morning_exam_scores")
}

model ScoreTarget {
  id          String   @id @default(cuid())
  studentId   String   @map("student_id")
  examTypeId  String   @map("exam_type_id")
  targetScore Int      @map("target_score")
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  examType    ExamType @relation(fields: [examTypeId], references: [id], onDelete: Cascade)

  @@unique([studentId, examTypeId])
  @@index([examTypeId])
  @@map("score_targets")
}

model StudyRoom {
  id           String   @id @default(cuid())
  divisionId   String   @map("division_id")
  name         String
  columns      Int      @default(9)
  rows         Int      @default(6)
  aisleColumns Json     @default("[]") @map("aisle_columns")
  isActive     Boolean  @default(true) @map("is_active")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  division     Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  seats        Seat[]

  @@unique([divisionId, name])
  @@index([divisionId])
  @@map("study_rooms")
}

model Seat {
  id          String    @id @default(cuid())
  divisionId  String    @map("division_id")
  studyRoomId String    @map("study_room_id")
  label       String
  positionX   Int       @map("position_x")
  positionY   Int       @map("position_y")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  division    Division  @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  studyRoom   StudyRoom @relation(fields: [studyRoomId], references: [id], onDelete: Cascade)
  student     Student?

  // @@unique([studyRoomId, label]) -- SQL partial unique index로 관리 (빈 label 허용)
  @@unique([studyRoomId, positionX, positionY])
  @@index([divisionId])
  @@index([studyRoomId])
  @@map("seats")
}

model DivisionSettings {
  id                          String   @id @default(cuid())
  divisionId                  String   @unique @map("division_id")
  warnLevel1                  Int      @default(10) @map("warn_level1")
  warnLevel2                  Int      @default(20) @map("warn_level2")
  warnInterview               Int      @default(25) @map("warn_interview")
  warnWithdraw                Int      @default(30) @map("warn_withdraw")
  warnMsgLevel1               String?  @map("warn_msg_level1")
  warnMsgLevel2               String?  @map("warn_msg_level2")
  warnMsgInterview            String?  @map("warn_msg_interview")
  warnMsgWithdraw             String?  @map("warn_msg_withdraw")
  tardyMinutes                Int      @default(20) @map("tardy_minutes")
  assistantPastEditAllowed    Boolean  @default(false) @map("assistant_past_edit_allowed")
  assistantPastEditDays       Int      @default(0) @map("assistant_past_edit_days")
  holidayLimit                Int      @default(1) @map("holiday_limit")
  halfDayLimit                Int      @default(2) @map("half_day_limit")
  healthLimit                 Int      @default(1) @map("health_limit")
  holidayUnusedPts            Int      @default(5) @map("holiday_unused_pts")
  halfDayUnusedPts            Int      @default(2) @map("half_day_unused_pts")
  tardyPointRuleId            String?  @map("tardy_point_rule_id")
  absentPointRuleId           String?  @map("absent_point_rule_id")
  operatingDays               Json     @default("{}") @map("operating_days")
  studyTracks                 Json     @default("[]") @map("study_tracks")
  pointCategories             Json     @default("[]") @map("point_categories")
  featureFlags                Json     @default("{}") @map("feature_flags")
  managementPolicy            Json?    @map("management_policy")
  perfectAttendancePtsEnabled Boolean  @default(false) @map("perfect_attendance_pts_enabled")
  perfectAttendancePts        Int      @default(0) @map("perfect_attendance_pts")
  expirationWarningDays       Int      @default(14) @map("expiration_warning_days")
  updatedAt                   DateTime @updatedAt @map("updated_at")
  division                    Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)

  @@map("division_settings")
}

model Admin {
  id                        String             @id @default(cuid())
  userId                    String             @unique @map("user_id")
  name                      String
  role                      AdminRole
  divisionId                String?            @map("division_id")
  isActive                  Boolean            @default(true) @map("is_active")
  createdAt                 DateTime           @default(now()) @map("created_at")
  division                  Division?          @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  attendanceRecords         Attendance[]       @relation("AttendanceRecordedBy")
  pointRecords              PointRecord[]      @relation("PointRecordedBy")
  leaveApprovals            LeavePermission[]  @relation("LeaveApprovedBy")
  interviewsCreated         Interview[]        @relation("InterviewCreatedBy")
  interviewsClosed          Interview[]        @relation("InterviewClosedBy")
  paymentsRecorded          Payment[]          @relation("PaymentRecordedBy")
  examScoresRecorded        ExamScore[]        @relation("ExamRecordedBy")
  morningExamScoresRecorded MorningExamScore[] @relation("MorningExamRecordedBy")
  announcementsCreated      Announcement[]     @relation("AnnouncementCreatedBy")
  examSchedulesCreated      ExamSchedule[]     @relation("ExamScheduleCreatedBy")
  phoneSubmissionsRecorded  PhoneSubmission[]  @relation("PhoneSubmissionRecordedBy")
  chatMessagesAuthored      ChatMessage[]      @relation("ChatMessageAuthor")
  chatMessagesDeleted       ChatMessage[]      @relation("ChatMessageDeletedBy")
  chatReadStates            ChatReadState[]    @relation("ChatReadStateAdmin")
  warningNoticesSent        WarningNotice[]    @relation("WarningNoticeNoticedBy")
  settingsChanges           DivisionSettingsHistory[] @relation("DivisionSettingsChangedBy")

  @@index([divisionId])
  @@map("admins")
}

model Announcement {
  id          String    @id @default(cuid())
  divisionId  String?   @map("division_id")
  title       String
  content     String
  isPinned    Boolean   @default(false) @map("is_pinned")
  publishedAt DateTime? @map("published_at")
  createdById String    @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  division    Division? @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  createdBy   Admin     @relation("AnnouncementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([divisionId])
  @@index([createdById])
  @@index([publishedAt])
  @@map("announcements")
}

model ExamSchedule {
  id          String           @id @default(cuid())
  divisionId  String           @map("division_id")
  name        String
  type        ExamScheduleType
  examDate    DateTime         @map("exam_date") @db.Date
  description String?
  isActive    Boolean          @default(true) @map("is_active")
  createdById String           @map("created_by_id")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  division    Division         @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  createdBy   Admin            @relation("ExamScheduleCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([divisionId, examDate])
  @@index([createdById])
  @@map("exam_schedules")
}

model PhoneSubmission {
  id           String                @id @default(cuid())
  divisionId   String                @map("division_id")
  studentId    String                @map("student_id")
  periodId     String                @map("period_id")
  date         DateTime              @db.Date
  status       PhoneSubmissionStatus @default(SUBMITTED)
  rentalNote   String?               @map("rental_note")
  recordedById String                @map("recorded_by_id")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")
  division     Division              @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  student      Student               @relation(fields: [studentId], references: [id], onDelete: Restrict)
  period       Period                @relation(fields: [periodId], references: [id], onDelete: Cascade)
  recordedBy   Admin                 @relation("PhoneSubmissionRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)

  @@unique([studentId, date, periodId])
  @@index([divisionId, date])
  @@map("phone_submissions")
}

/// 지점 단위 직원 단체 채팅. 지점당 방이 하나이므로 방 테이블을 따로 두지 않고
/// division_id 를 방 식별자로 쓴다.
model ChatMessage {
  id          String    @id @default(cuid())
  divisionId  String    @map("division_id")
  // 직원 계정이 영구 삭제되어도 대화 기록은 남아야 하므로 nullable + SetNull.
  // 표시 이름은 작성 시점 스냅샷을 함께 보관한다.
  authorId    String?   @map("author_id")
  authorName  String    @map("author_name")
  body        String
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  deletedById String?   @map("deleted_by_id")
  division    Division  @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  author      Admin?    @relation("ChatMessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  deletedBy   Admin?    @relation("ChatMessageDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  @@index([divisionId, createdAt])
  // 증분 동기화 커서. 소프트 삭제는 updatedAt 만 올리므로 createdAt 기준으로는 삭제를 놓친다.
  @@index([divisionId, updatedAt])
  @@index([authorId])
  @@map("chat_messages")
}

/// 지점별·직원별 마지막 읽은 시각. SUPER_ADMIN 은 division_id 가 없고 여러 지점을 오가므로
/// admins 컬럼 하나로는 표현할 수 없어 (division, admin) 복합키로 둔다.
model ChatReadState {
  id         String   @id @default(cuid())
  divisionId String   @map("division_id")
  adminId    String   @map("admin_id")
  lastReadAt DateTime @default(now()) @map("last_read_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  division   Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  admin      Admin    @relation("ChatReadStateAdmin", fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([divisionId, adminId])
  @@index([adminId])
  @@map("chat_read_states")
}
