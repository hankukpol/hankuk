MOCK_MODE=false
# Set these only when you intentionally want local dev to hit remote services.
ALLOW_REMOTE_DATABASE_IN_LOCAL=false
NEXT_PUBLIC_ALLOW_REMOTE_SUPABASE_IN_LOCAL=false
