# Transitional default tenant for local/dev only.
# Production should resolve police/fire from the request path.
NEXT_PUBLIC_TENANT_TYPE=police

# Unified Supabase (hankuk-main) - class_pass schema shared by police/fire
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT signing secret (minimum 32 random characters)
JWT_SECRET=replace-with-a-32-char-random-secret

# Required in production when the first super admin bootstrap endpoint is used.
SUPER_ADMIN_BOOTSTRAP_TOKEN=replace-with-a-one-time-bootstrap-token

# QR token HMAC secret (minimum 32 random characters)
QR_HMAC_SECRET=replace-with-a-32-char-random-secret

# Attendance 6-digit code HMAC secret (minimum 32 random characters)
ATTENDANCE_HMAC_SECRET=replace-with-a-32-char-random-secret

# Local public URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORTAL_URL=https://portal.hankukpol.co.kr
NEXT_PUBLIC_PORTAL_URL=https://portal.hankukpol.co.kr
# Development-only escape hatch for old in-app browsers that omit Origin/Referer.
PORTAL_BRIDGE_ALLOW_MISSING_ORIGIN=false

# Optional: enable when the custom domain cutover to *.hankukpol.co.kr is complete.
COOKIE_DOMAIN=
