FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates socat && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@10.0.0 --activate
ARG APP
ENV HANKUK_APP=$APP NEXT_TELEMETRY_DISABLED=1
WORKDIR /workspace
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/config ./packages/config
COPY apps/${APP}/package.json ./apps/${APP}/package.json
RUN pnpm --filter ./apps/${APP}... install --frozen-lockfile --ignore-scripts
COPY apps/${APP} ./apps/${APP}
COPY docker/runtime.mjs /workspace/docker/runtime.mjs
WORKDIR /workspace/apps/${APP}
CMD ["node", "/workspace/docker/runtime.mjs"]
