FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@10.0.0 --activate
WORKDIR /workspace
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/config ./packages/config
COPY apps/study-hall/package.json ./apps/study-hall/package.json
RUN pnpm --filter ./apps/study-hall... install --frozen-lockfile
COPY apps/study-hall ./apps/study-hall
WORKDIR /workspace/apps/study-hall
EXPOSE 3000
CMD ["pnpm", "dev:runtime", "--hostname", "0.0.0.0"]
