          },
          {
            "action": "rebuild",
            "path": "pnpm-lock.yaml"
          },
          {
            "action": "sync+restart",
            "path": "packages/config",
            "target": "/workspace/packages/config",
            "ignore": [
              "node_modules/"
            ]
          }
        ]
      },
      "healthcheck": {
        "test": [
          "CMD",
          "node",
          "-e",
          "fetch('http://127.0.0.1:3200/police/login').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
        ],
        "interval": "30s",
        "timeout": "25s",
        "start_period": "120s",
        "retries": 5
