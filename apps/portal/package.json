{
  "name": "portal",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('.next', { recursive: true, force: true })\"",
    "dev": "node ../../scripts/docker-dev.mjs dev portal",
    "prebuild": "node -e \"require('node:fs').rmSync('.next', { recursive: true, force: true })\"",
    "build": "next build",
    "start": "next start",
    "dev:runtime": "next dev",
    "dev:stop": "node ../../scripts/docker-dev.mjs stop portal",
    "dev:logs": "node ../../scripts/docker-dev.mjs logs portal",
    "predev:runtime": "node -e \"require('node:fs').rmSync('.next', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@hankuk/config": "workspace:*",
    "@supabase/supabase-js": "^2.100.1",
    "jose": "^5.10.0",
    "next": "^15.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.8.0"
  }
}
